# Use a separate Supabase project and a dedicated test account.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_TEST_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_TEST_SERVICE_ROLE_KEY

# Use a project-scoped OpenAI key with a conservative spend limit.
OPENAI_API_KEY=YOUR_TEST_OPENAI_KEY
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

E2E_USER_EMAIL=northstar-test@example.com
E2E_USER_PASSWORD=REPLACE_WITH_A_TEST_PASSWORD
CRON_SECRET=REPLACE_WITH_A_RANDOM_TEST_SECRET
NEXT_PUBLIC_VAPID_PUBLIC_KEY=REPLACE_WITH_TEST_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_TEST_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:northstar-test@example.com

# Use a dedicated Google Cloud OAuth client and test Google account.
GOOGLE_CLIENT_ID=REPLACE_WITH_TEST_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_TEST_GOOGLE_CLIENT_SECRET
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
CALENDAR_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_TEST_KEY
